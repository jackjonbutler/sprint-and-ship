# Claude (one of the two)
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# GitHub fine-grained PAT: contents rw + pull requests rw on your repos
GH_TOKEN=
# Notion internal integration (share your teamspace with it)
NOTION_TOKEN=
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_DEV=      # build questions, blocked tickets, night summaries
TELEGRAM_CHAT_ID_REPORTS=  # weekly reports, GSC/analytics digests
TELEGRAM_CHAT_ID=          # legacy fallback (optional)
TELEGRAM_OWNER_ID=         # your personal Telegram user id — only this user can send commands
# Repos the agents work on: name=clone-url, space separated
REPOS="mobile-app=https://github.com/you/mobile-app.git api=https://github.com/you/api.git website=https://github.com/you/website.git"
# Optional
REVENUECAT_API_KEY=
REVENUECAT_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/work/prompts/gsc-service-account.json
MAX_TICKETS_PER_NIGHT=6

# Merge train: which repo's PRs to land automatically, and into which branch
MERGE_TRAIN_REPO=owner/repo
MERGE_TRAIN_BASE=development
